# ============================================================================
# FinFlow environment configuration — TEMPLATE
#
# Copy to `.env` and fill in values.  `.env` is gitignored and must NEVER be
# committed.  No real financial credentials ever belong in this file — the
# platform never connects to banks.  The only secrets here are for the
# *outbound* Telegram notification channel.
# ============================================================================

# --- Runtime ---
FINFLOW_ENV=dev
FINFLOW_LOG_LEVEL=INFO
# Timezone used for transaction timestamps and daily summary boundaries
FINFLOW_TIMEZONE=Asia/Kolkata

# --- Paths (relative to repo root; absolute paths also accepted) ---
FINFLOW_DATA_DIR=data
FINFLOW_DB_PATH=data/finflow.duckdb

# --- Notifications: Telegram bot (https://core.telegram.org/bots/tutorial) ---
# 1. Talk to @BotFather -> /newbot -> copy the token
# 2. Send your bot a message, then get your chat id from
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# Leave empty to disable Telegram notifications.
FINFLOW_TELEGRAM_BOT_TOKEN=
FINFLOW_TELEGRAM_CHAT_ID=

# --- Safety switches ---
# DEMO_MODE=true forces every service (dashboard, notifications) to read from
# the synthetic demo database only. Must be true for any public deployment.
FINFLOW_DEMO_MODE=false
FINFLOW_DEMO_DB_PATH=data/demo/finflow_demo.duckdb

# Master switch for outbound notifications (fail-safe default: off)
FINFLOW_NOTIFY_ENABLED=false
